{
  "name": "four-player-multiverse-chess",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run world:build && tsc --noEmit && node scripts/build.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "dev": "npm run build && node scripts/serve.mjs",
    "preview": "node scripts/serve.mjs",
    "test:browser": "npm run build && node --test tests/*.spec.mjs",
    "deploy": "npm run build && wrangler deploy",
    "server": "node dist/server.mjs",
    "dev:server": "npm run build && node dist/server.mjs",
    "data:check": "node dist/storage-admin.mjs check",
    "data:migrate": "node dist/storage-admin.mjs migrate",
    "data:backup": "node dist/storage-admin.mjs backup",
    "data:export": "node dist/storage-admin.mjs export",
    "demo": "npm run build && node scripts/demo.mjs",
    "world:build": "node scripts/world-build.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "0.187.0",
    "@types/ws": "^8.18.2",
    "esbuild": "0.27.3",
    "playwright": "^1.58.2",
    "typescript": "5.9.3",
    "wrangler": "4.160.0"
  },
  "dependencies": {
    "three": "0.187.0",
    "ws": "8.21.0"
  }
}
