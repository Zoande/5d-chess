{
  "name": "four-player-multiverse-chess",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "dev": "npm run build && node scripts/serve.mjs",
    "preview": "node scripts/serve.mjs",
    "test:browser": "npm run build && node --test tests/browser.spec.mjs",
    "deploy": "npm run build && wrangler deploy",
    "server": "node dist/server.mjs",
    "dev:server": "npm run build && node dist/server.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "0.27.3",
    "playwright": "^1.58.2",
    "typescript": "5.9.3",
    "wrangler": "4.160.0"
  }
}
